{
  "name": "regex-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node --import tsx scripts/generate-sitemap.ts",
    "build:dev": "vite build --mode development && node --import tsx scripts/generate-sitemap.ts development",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check:biome": "biome check --write .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:content": "tsx scripts/verify-content.ts",
    "verify:codegen": "tsx scripts/verify-codegen.ts",
    "verify:debugger": "node --import tsx scripts/verify-debugger.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "cf:dev": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:built": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/language": "^6.12.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.16",
    "@lezer/highlight": "^1.2.3",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-start": "^1.167.65",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.7.2",
    "shadcn": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@inlang/paraglide-js": "^2.18.0",
    "@playwright/test": "^1.63.0",
    "@tanstack/router-plugin": "^1.167.35",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.18",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.90.0"
  }
}
